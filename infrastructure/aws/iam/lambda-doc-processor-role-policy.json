{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadUploadedDocument",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::capstone-mortgage-docs-dev/mortgages/*"
    },
    {
      "Sid": "WriteDocumentMetadata",
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem"],
      "Resource": "arn:aws:dynamodb:us-east-1:*:table/DocumentMetadata-dev"
    },
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-1:*:log-group:/aws/lambda/capstone-doc-processor-dev:*"
    }
  ]
}
