{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublishLifecycleEvents",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:us-east-1:*:capstone-mortgage-lifecycle-dev"
    },
    {
      "Sid": "ConsumeServicingEventsQueue",
      "Effect": "Allow",
      "Action": ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes"],
      "Resource": "arn:aws:sqs:us-east-1:*:capstone-mortgage-servicing-dev"
    },
    {
      "Sid": "MortgageLookupTable",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:Query"],
      "Resource": "arn:aws:dynamodb:us-east-1:*:table/MortgageLookup-dev"
    }
  ]
}
