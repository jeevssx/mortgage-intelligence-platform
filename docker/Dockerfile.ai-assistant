# Build for ai/mortgage-knowledge-assistant (M7). Build context must be the repo root:
#   docker build -f docker/Dockerfile.ai-assistant -t ai-assistant .

FROM python:3.11-slim
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --system --create-home capstone
WORKDIR /app
COPY ai/mortgage-knowledge-assistant/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY ai/mortgage-knowledge-assistant/src ./src
COPY ai/mortgage-knowledge-assistant/knowledge ./knowledge
RUN python -m src.ingestion.ingest
USER capstone
EXPOSE 8001
HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=5 \
    CMD curl -sf http://localhost:8001/health || exit 1
CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8001"]
