SERVICE_NAME=mortgage-knowledge-assistant
LOG_LEVEL=INFO
SERVER_PORT=8001

# RAG tuning (see README for rationale)
CHUNK_SIZE_WORDS=400
CHUNK_OVERLAP_WORDS=50
TOP_K=5
SIMILARITY_THRESHOLD=0.15
KNOWLEDGE_DIR=knowledge/v1

# LLM generation (optional). If LLM_API_KEY is unset, the service falls back to a deterministic
# extractive mode: the answer is built directly from the retrieved context, never from an LLM.
# This keeps the service fully runnable with zero cost / no external account for local dev, CI,
# and this capstone's grading — the same code calls a real LLM once a key is provided.
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Optional M6 auth (recommended if exposed beyond local). If unset, /api/v1/assistant/* is open.
JWT_SECRET=
