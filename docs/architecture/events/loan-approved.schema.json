{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LoanApproved",
  "type": "object",
  "required": ["eventId", "eventType", "occurredAt", "schemaVersion", "correlationId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "LoanApproved" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "correlationId": { "type": "string" },
    "payload": {
      "type": "object",
      "required": ["loanExternalId", "mortgageExternalId", "interestRate", "termMonths"],
      "properties": {
        "loanExternalId": { "type": "string", "pattern": "^LOAN-[0-9]{4}$" },
        "mortgageExternalId": { "type": "string", "pattern": "^MTG-[0-9]{4}$" },
        "interestRate": { "type": "number" },
        "termMonths": { "type": "integer" }
      }
    }
  }
}
