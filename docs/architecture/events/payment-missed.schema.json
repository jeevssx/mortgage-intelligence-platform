{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PaymentMissed",
  "type": "object",
  "required": ["eventId", "eventType", "occurredAt", "schemaVersion", "correlationId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "PaymentMissed" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "correlationId": { "type": "string" },
    "payload": {
      "type": "object",
      "required": ["mortgageExternalId", "dueDate", "amount"],
      "properties": {
        "mortgageExternalId": { "type": "string", "pattern": "^MTG-[0-9]{4}$" },
        "dueDate": { "type": "string", "format": "date" },
        "amount": { "type": "number" }
      }
    }
  }
}
