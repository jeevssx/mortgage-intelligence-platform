{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LoanDelinquent",
  "type": "object",
  "required": ["eventId", "eventType", "occurredAt", "schemaVersion", "correlationId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "LoanDelinquent" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "correlationId": { "type": "string" },
    "payload": {
      "type": "object",
      "required": ["mortgageExternalId", "daysPastDue", "severity"],
      "properties": {
        "mortgageExternalId": { "type": "string", "pattern": "^MTG-[0-9]{4}$" },
        "daysPastDue": { "type": "integer" },
        "severity": { "type": "string", "enum": ["LOW", "MODERATE", "HIGH", "SEVERE"] }
      }
    }
  }
}
