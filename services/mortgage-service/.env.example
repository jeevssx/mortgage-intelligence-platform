SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
LOG_LEVEL=INFO

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mortgage_intel
POSTGRES_USER=mortgage_app
POSTGRES_PASSWORD=change-me

# M5 lifecycle events (optional — unset means publish is a no-op). LocalStack only:
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
SNS_TOPIC_MORTGAGE_EVENTS=arn:aws:sns:us-east-1:000000000000:capstone-mortgage-lifecycle-dev

# M6 JWT auth. Must be IDENTICAL to servicing-service's JWT_SECRET (shared-secret validation,
# no inter-service call — see docs/security/security-controls.md). If unset, both services fall
# back to the same insecure dev-only default and log a warning; outside dev/test profiles they
# refuse to start instead. Generate a real value with: openssl rand -base64 32
JWT_SECRET=
JWT_ISSUER=capstone-mortgage-auth
JWT_EXPIRY_SECONDS=3600
