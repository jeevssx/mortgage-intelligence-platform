SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081
LOG_LEVEL=INFO

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mortgage_intel
POSTGRES_USER=mortgage_app
POSTGRES_PASSWORD=change-me

# M5 lifecycle events (optional — unset means publish/consume are no-ops). LocalStack only:
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
SNS_TOPIC_MORTGAGE_EVENTS=arn:aws:sns:us-east-1:000000000000:capstone-mortgage-lifecycle-dev
SQS_QUEUE_SERVICING_EVENTS=http://localhost:4566/000000000000/capstone-mortgage-servicing-dev
SQS_POLL_DELAY_MS=2000
